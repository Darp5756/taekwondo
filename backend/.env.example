# Cadena de conexión PostgreSQL (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://tkd:tkd@localhost:5432/taekwondo
# Secreto para firmar los JWT (usa un valor largo y aleatorio: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera.
CORS_ORIGINS=http://localhost:5173
# Opcional: usuario administrador que crea `npm run db:seed`
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@taekwondo.local
ADMIN_PASSWORD=admin1234
# Base de datos SOLO para tests: `npm test` la vacía y la recrea.
TEST_DATABASE_URL=postgres://tkd:tkd@localhost:5432/taekwondo_test
